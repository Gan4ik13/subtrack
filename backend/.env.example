# Копируйте в .env и заполняйте реальными значениями. Файл .env в git не коммитится.
# Локальный запуск бэкенда: из каталога backend —
#   set -a && source .env && set +a && uvicorn main:app --reload --port 8000

# Режим оплаты: yookassa | yoomoney | cryptopay | manual
PAYMENT_MODE=yookassa

# ЮKassa (shopId + секретный ключ из кабинета kassa.yandex.ru → Интеграция → Ключи API)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Код НДС для чека самозанятого (1 = НДС не облагается)
YOOKASSA_VAT_CODE=1

# Telegram-бот напоминаний (@SubPingBot): токен от @BotFather
TG_BOT_TOKEN=
# Chat ID владельца для уведомлений об оплатах (узнать: @userinfobot)
OWNER_TG_CHAT_ID=
# Email владельца (доступ к /api/admin/payments)
OWNER_EMAIL=

# Сайт (CORS + return_url платежей)
FRONTEND_ORIGIN=https://subping.ru

# БД: пусто = SQLite-файл рядом с кодом; для Postgres — postgres://...
DATABASE_URL=

# ЮMoney (только если PAYMENT_MODE=yoomoney)
YOOMONEY_WALLET=
YOOMONEY_TOKEN=
YOOMONEY_NOTIFY_SECRET=

# «Мой налог» — автоматические чеки самозанятого (ЮKassa с 29.12.2025 чеки не шлёт)
MYNALOG_INN=772623564429
# пароль из личного кабинета lknpd.nalog.ru (включается в настройках профиля ФНС)
MYNALOG_PASSWORD=
# TRANSFER_OF_FUNDS — безнал (карта/СБП); CASH — наличные
MYNALOG_PAYMENT_TYPE=TRANSFER_OF_FUNDS
